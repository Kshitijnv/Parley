{
  "name": "parley",
  "productName": "Parley",
  "version": "0.1.0",
  "private": true,
  "description": "Live call assistant: transcript and AI answers in an always-on-top overlay (own-use clone).",
  "main": "./out/main/index.js",
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev",
    "dev:web": "vite --config vite.web.config.ts",
    "build": "electron-vite build",
    "build:web": "vite build --config vite.web.config.ts",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "screens": "node scripts/screens.mjs",
    "smoke:electron": "node scripts/electron-smoke.mjs",
    "smoke:backend": "node scripts/backend-smoke.mjs .smoke",
    "smoke:pipeline": "node scripts/pipeline-smoke.mjs .smoke",
    "test:classifier": "node scripts/classifier-test.mjs",
    "test:unit": "playwright test --project=unit",
    "test:e2e": "playwright test --project=unit --project=electron",
    "test:real": "playwright test --project=real"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.90",
    "@ai-sdk/google": "^4.0.107",
    "@ai-sdk/groq": "^4.0.72",
    "@ai-sdk/openai": "^4.0.104",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "ai": "^7.0.155",
    "katex": "^0.19.1",
    "lucide-react": "^1.62.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "sherpa-onnx-node": "^2.0.1",
    "shiki": "^4.5.0",
    "unpdf": "^1.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^45.0.0",
    "electron-vite": "^6.0.0",
    "playwright": "^1.64.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  }
}
