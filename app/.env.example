# Copy to .env.local for local development. Never commit .env.local.
#
# .env.local is read only by development builds (npm run dev, or the built app run
# from this folder). A packaged app ignores it: there, each user saves their own keys
# in Settings, where they are encrypted with Windows DPAPI (Electron safeStorage).
# Never ship a shared key inside the app: anything in the installer can be extracted.

# --- AI providers (any one is enough; Gemini is the default) ---
GEMINI_API_KEY=
# GOOGLE_GENERATIVE_AI_API_KEY=   (same as GEMINI_API_KEY)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=

# --- Optional ---
# Company logos in the company field (logo.dev).
LOGODEV_API_KEY=
# Saved for the future Deepgram speech-to-text provider; not used yet.
DEEPGRAM_API_KEY=

# --- Development switches ---
# 1 = use the renderer's demo data layer instead of the real one (shows "Demo data").
PARLEY_MOCK=
# 1 = ignore the keys above and use only keys saved in Settings.
PARLEY_IGNORE_ENV_KEYS=
# 1 = log AI error types and provider error bodies (never prompts or keys).
PARLEY_DEBUG_AI=
# Speech model: kroko (default, CC-BY-SA) or zipformer-2023 (Apache-2.0).
PARLEY_STT_MODEL=
# JSON map from catalog id to provider model id, e.g. {"google:gemini-flash":"gemini-3.5-flash"}
PARLEY_MODEL_MAP=

# --- Test-only (development builds) ---
# Use this folder instead of %APPDATA%\parley.
PARLEY_USER_DATA=
# Parent folder for downloaded speech models (kept between test runs).
PARLEY_STT_MODEL_DIR=
# Lets automated tests import files from this folder without the native picker.
PARLEY_TEST_ALLOW_DIR=
